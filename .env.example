# LLM Orchestration (MedGemma 1.5 via Groq)
GROQ_API_KEY=your_groq_api_key_here

# Structured Knowledge (Neo4j) - REQUIRED: No defaults provided
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Semantic Search
CHROMA_HOST=localhost
CHROMA_PORT=8000
BIOLORD_MODEL_NAME=FremyCompany/BioLORD-2023

# Hybrid Ranking
GRAPH_WEIGHT=0.6
SEMANTIC_WEIGHT=0.4

# Data Files
ORPHANET_PRODUCT1_XML=data/raw/en_product1.xml
ORPHANET_PRODUCT4_XML=data/raw/en_product4.xml
ORPHANET_PRODUCT6_XML=data/raw/en_product6.xml
PUBMED_CACHE_FILE=data/processed/pubmed_cache.json

# External Tools (Phase 2)
NCBI_API_KEY=your_ncbi_api_key_here
